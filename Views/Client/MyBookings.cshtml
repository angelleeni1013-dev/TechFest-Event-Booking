@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager
@model List<Booking>
@{
    ViewData["Title"] = "My Bookings";
    var user = await UserManager.GetUserAsync(User);
}

<div class="container mt-4 fade-in-up">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="page-title" style="text-align: left; color: #3a2d34;">
                <i class="bi bi-ticket-perforated"></i> My Bookings
            </h1>
            <p class="text-muted">Welcome back, <strong>@user?.Email</strong></p>
        </div>
        <a asp-action="CreateBooking" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Book Tickets
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i><strong>Success!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i><strong>Error!</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="bi bi-info-circle-fill me-2"></i>@TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="stat-card">
                <h5>Total Bookings</h5>
                <h2>@Model.Count</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card" style="border-left-color: #28a745;">
                <h5>Confirmed</h5>
                <h2>@Model.Count(b => b.Status == "Confirmed")</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card" style="border-left-color: #ffc107;">
                <h5>Pending Payment</h5>
                <h2>@Model.Count(b => b.PaymentStatus == "Unpaid")</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card" style="border-left-color: #17a2b8;">
                <h5>Total Spent</h5>
                <h2>RM @Model.Where(b => b.PaymentStatus == "Paid").Sum(b => b.Charges).ToString("N2")</h2>
            </div>
        </div>
    </div>

    <!-- Bookings Table -->
    @if (Model.Any())
    {
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-list-ul"></i> Booking History</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead style="background-color: #3a2d34; color: white;">
                            <tr>
                                <th>Booking ID</th>
                                <th>Event</th>
                                <th>Day</th>
                                <th>Ticket Type</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Payment</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var booking in Model)
                            {
                                <tr>
                                    <td><strong>#@booking.BookingId</strong></td>
                                    <td>@booking.EventName</td>
                                    <td><span class="badge bg-info">Day @booking.Day</span></td>
                                    <td>
                                        @if (booking.TicketType == "early-bird")
                                        {
                                            <span class="badge bg-success">Early Bird</span>
                                        }
                                        else if (booking.TicketType == "regular")
                                        {
                                            <span class="badge bg-primary">Regular</span>
                                        }
                                        else if (booking.TicketType == "student")
                                        {
                                            <span class="badge bg-info">Student</span>
                                        }
                                    </td>
                                    <td><strong>RM @booking.Charges.ToString("N2")</strong></td>
                                    <td>
                                        @if (booking.Status == "Confirmed")
                                        {
                                            <span class="badge bg-success">@booking.Status</span>
                                        }
                                        else if (booking.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">@booking.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">@booking.Status</span>
                                        }
                                    </td>
                                    <td>
                                        @if (booking.PaymentStatus == "Paid")
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle"></i> Paid
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-clock"></i> Unpaid
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (booking.PaymentStatus == "Unpaid")
                                        {
                                            <a asp-action="PaymentDetails" asp-route-bookingId="@booking.BookingId"
                                               class="btn btn-sm btn-warning">
                                                <i class="bi bi-credit-card"></i> Pay Now
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-action="Invoice" asp-route-id="@booking.BookingId"
                                               class="btn btn-sm btn-success" target="_blank">
                                                <i class="bi bi-file-earmark-pdf"></i> Invoice
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card text-center py-5">
            <div class="card-body">
                <i class="bi bi-inbox" style="font-size: 4rem; color: #6c757d;"></i>
                <h3 class="mt-3">No Bookings Yet</h3>
                <p class="text-muted">You haven't made any bookings. Start by booking your tickets!</p>
                <a asp-action="CreateBooking" class="btn btn-primary mt-3">
                    <i class="bi bi-plus-circle"></i> Create Your First Booking
                </a>
            </div>
        </div>
    }
</div>