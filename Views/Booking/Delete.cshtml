@model A2_TechFest_2026.Models.Booking
@{
    ViewData["Title"] = "Delete Booking";
}

<div class="container mt-4">
    <h1 class="mb-4" style="color:#3a2d34">Delete Booking</h1>

    <div class="alert alert-warning" role="alert">
        <strong>Warning!</strong> Are you sure you want to delete this booking? This action cannot be undone.
    </div>

    <div class="card">
        <div class="card-header text-white" style="background-color:#3a2d34">
            <h5 class="mb-0">Booking Details to be Deleted</h5>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Booking ID:</dt>
                <dd class="col-sm-9">@Model.BookingId</dd>

                <dt class="col-sm-3">Event Name:</dt>
                <dd class="col-sm-9">@Model.EventName</dd>

                <dt class="col-sm-3">Client Name:</dt>
                <dd class="col-sm-9">@Model.ClientName</dd>

                <dt class="col-sm-3">Email:</dt>
                <dd class="col-sm-9">@Model.ClientEmail</dd>

                <dt class="col-sm-3">Contact Number:</dt>
                <dd class="col-sm-9">@Model.ContactNumber</dd>
                <dt class="col-sm-3">Date of Birth:</dt>
                <dd class="col-sm-9">@Model.DateOfBirth.ToString("yyyy-MM-dd") (Age: @Model.GetAge())</dd>

                <dt class="col-sm-3">Gender:</dt>
                <dd class="col-sm-9">
                    @if (Model.Gender == "Male")
                    {
                        <span class="badge bg-primary">@Model.Gender</span>
                    }
                    else if (Model.Gender == "Female")
                    {
                        <span class="badge bg-pink text-white">@Model.Gender</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@Model.Gender</span>
                    }
                </dd>

                <dt class="col-sm-3">Day:</dt>
                <dd class="col-sm-9"><span class="badge bg-info">Day @Model.Day</span></dd>

                <dt class="col-sm-3">Ticket Type:</dt>
                <dd class="col-sm-9">
                    @if (Model.TicketType == "early-bird")
                    {
                        <span class="badge bg-success">Early Bird (RM120/day)</span>
                    }
                    else if (Model.TicketType == "regular")
                    {
                        <span class="badge bg-primary">Regular (RM150/day)</span>
                    }
                    else if (Model.TicketType == "student")
                    {
                        <span class="badge bg-info">Student (RM80/day)</span>
                    }
                </dd>

                <dt class="col-sm-3">Charges:</dt>
                <dd class="col-sm-9">RM @Model.Charges.ToString("F2")</dd>

                <dt class="col-sm-3">Status:</dt>
                <dd class="col-sm-9">
                    @if (Model.Status.Trim() == "Confirmed")
                    {
                        <span class="badge bg-success">@Model.Status</span>
                    }
                    else if (Model.Status.Trim() == "Pending")
                    {
                        <span class="badge bg-warning text-dark">@Model.Status</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">@Model.Status</span>
                    }
                <dt class="col-sm-3">Payment Status:</dt>
                <dd class="col-sm-9">
                        @if (Model.PaymentStatus == "Paid")
                        {
                        <span class="badge bg-success">@Model.PaymentStatus</span>
                        }
                        else if (Model.PaymentStatus == "Unpaid")
                        {
                        <span class="badge bg-warning text-dark">@Model.PaymentStatus</span>
                        }
                        else
                        {
                        <span class="badge bg-dark text-white">@Model.PaymentStatus</span>
                        }
                </dd>

                <dt class="col-sm-3">Payment Method:</dt>
                <dd class="col-sm-9">
                        @if (!string.IsNullOrEmpty(Model.PaymentMethod))
                        {
                            @Model.PaymentMethod
                        }
                        else
                        {
                        <span class="text-muted">N/A</span>
                        }
                </dd>

            </dl>
        </div>
    </div>

    <form asp-action="DeleteConfirmed" method="post" class="mt-4" id="deleteForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="BookingId" name="bookingid" />

        <div class="d-flex gap-2">
            <button type="button" class="btn btn-danger btn-lg" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal">
                <i class="bi bi-trash"></i> Confirm Delete
            </button>
            <a asp-action="Index" class="btn btn-secondary btn-lg">
                <i class="bi bi-arrow-left"></i> Cancel
            </a>
        </div>
    </form>
</div>

<!-- Confirmation Modal -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle"></i> Confirm Deletion
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">Are you absolutely sure you want to delete this booking?</p>
                <p class="text-muted mb-1">Booking ID: <strong>@Model.BookingId</strong></p>
                <p class="text-muted mb-1">Client: <strong>@Model.ClientName</strong></p>
                <p class="text-muted mb-1">Event: <strong>@Model.EventName</strong></p>
                <p class="text-danger mt-3 mb-0"><strong>This action cannot be undone!</strong></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle"></i> Cancel
                </button>
                <button type="button" class="btn btn-danger" onclick="document.getElementById('deleteForm').submit();">
                    <i class="bi bi-trash"></i> Yes, Delete It
                </button>
            </div>
        </div>
    </div>
</div>