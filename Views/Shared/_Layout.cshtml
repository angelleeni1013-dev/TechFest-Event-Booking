<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechFest 2026</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/techfest-theme.css" asp-append-version="true" />
    <style>
        body {
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            background-color: white;
        }

        .navbar-brand {
            font-weight: 600;
            font-size: 1.5rem;
        }

        .gradient-text {
            background: linear-gradient(45deg, #ffffff, #7996e0);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-link {
            font-weight: 500;
            transition: all 0.3s ease;
        }

            .nav-link:hover {
                color: #667eea !important;
                transform: translateY(-2px);
            }

            .nav-link.active {
                color: #667eea !important;
                border-bottom: 2px solid #667eea;
            }

        footer {
            background: #3a2d34;
            color: white;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light border-bottom shadow-sm mb-4" style="background-color:#3a2d34">
            <div class="container-fluid">
                <a class="navbar-brand gradient-text" asp-controller="Home" asp-action="Index">
                    TechFest 2026
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation" style="background-color: white;">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    @using Microsoft.AspNetCore.Identity
                    @inject UserManager<IdentityUser> UserManager
                    @inject SignInManager<IdentityUser> SignInManager

                    @if (SignInManager.IsSignedIn(User))
                    {
                        var currentUser = await UserManager.GetUserAsync(User);
                        var userRoles = currentUser != null ? await UserManager.GetRolesAsync(currentUser) : new List<string>();
                        var isClient = userRoles.Contains("Client");
                        var isAdmin = userRoles.Contains("Admin");
                        var isStaff = userRoles.Contains("Staff");

                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index" style="color:white">
                                    <i class="bi bi-house-door"></i> Home
                                </a>
                            </li>

                            @if (isClient)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Client" asp-action="MyBookings" style="color:white">
                                        <i class="bi bi-ticket-perforated"></i> My Bookings
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Client" asp-action="CreateBooking" style="color:white">
                                        <i class="bi bi-plus-circle"></i> Book Tickets
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Inquiry" asp-action="MyInquiries" style="color:white">
                                        <i class="bi bi-question-circle"></i> My Inquiries
                                    </a>
                                </li>
                            }

                            @if (isAdmin || isStaff)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Booking" asp-action="Index" style="color:white">
                                        <i class="bi bi-list-ul"></i> All Bookings
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Inquiry" asp-action="Manage" style="color:white">
                                        <i class="bi bi-inbox"></i> Inquiries
                                    </a>
                                </li>
                            }

                            @if (isAdmin)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Booking" asp-action="Add" style="color:white">
                                        <i class="bi bi-plus-circle"></i> New Booking
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index" style="color:white">
                                    <i class="bi bi-house-door"></i> Home
                                </a>
                            </li>
                        </ul>
                    }
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
    <footer class="mt-5 py-4">
        <div class="container text-center">
            <p class="mb-0">&copy; 2026 TechFest 2026 - UOW Malaysia KDU Penang UC</p>
            <p class="mb-0 mt-2" style="opacity: 0.8; font-size: 0.875rem;">
                <i class="bi bi-envelope"></i> techfestevent2026@gmail.com |
                <i class="bi bi-telephone"></i> +60 3-1234 5678
            </p>
            <p class="mb-0 mt-1" style="opacity: 0.7; font-size: 0.75rem;">
                Manage your event bookings with ease
            </p>
        </div>
    </footer>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>