@model IEnumerable<Inquiry>
@{
    ViewData["Title"] = "Manage Inquiries";
}

<div class="container mt-4">
    <h2 class="mb-4" style="color: #3a2d34;">
        <i class="bi bi-inbox"></i> Manage Client Inquiries
    </h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card stat-card" style="border-left: 4px solid #ffc107;">
                <div class="card-body">
                    <h6 class="text-muted">Pending</h6>
                    <h2 style="color: #ffc107;">@ViewBag.PendingCount</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card" style="border-left: 4px solid #17a2b8;">
                <div class="card-body">
                    <h6 class="text-muted">Responded</h6>
                    <h2 style="color: #17a2b8;">@ViewBag.RespondedCount</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card" style="border-left: 4px solid #28a745;">
                <div class="card-body">
                    <h6 class="text-muted">Solved</h6>
                    <h2 style="color: #28a745;">@ViewBag.SolvedCount</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox" style="font-size: 4rem; color: #ccc;"></i>
                    <h5 class="mt-3 text-muted">No inquiries yet</h5>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead style="background-color: #3a2d34; color: white;">
                            <tr>
                                <th>ID</th>
                                <th>Client Email</th>
                                <th>Subject</th>
                                <th>Status</th>
                                <th>Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>#@item.InquiryId</td>
                                    <td>@item.ClientEmail</td>
                                    <td>@item.Subject</td>
                                    <td>
                                        @if (item.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                        else if (item.Status == "Responded")
                                        {
                                            <span class="badge bg-info">Responded</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Solved</span>
                                        }
                                    </td>
                                    <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <a asp-action="Reply" asp-route-id="@item.InquiryId" class="btn btn-sm btn-primary">
                                            <i class="bi bi-reply"></i> Reply
                                        </a>
                                        @if (item.Status != "Solved")
                                        {
                                            <a asp-action="MarkSolved" asp-route-id="@item.InquiryId" class="btn btn-sm btn-success">
                                                <i class="bi bi-check-circle"></i> Mark Solved
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>